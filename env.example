# Copie este arquivo para .env e preencha com os seus valores
# (no Render/Railway configure direto no painel de variáveis de ambiente)

# Token de PRODUÇÃO do Mercado Pago (painel > Suas integrações > Credenciais)
MP_ACCESS_TOKEN=

# Secret do webhook (Mercado Pago > Suas integrações > Webhooks > chave secreta)
# É o que prova que o aviso de pagamento veio mesmo do Mercado Pago
MP_WEBHOOK_SECRET=

# Domínio do seu site (para o CORS aceitar as chamadas do jogo)
ALLOWED_ORIGIN=https://seu-site.netlify.app

# Postgres do Render (persistência real de usuários e cobranças) — opcional
DATABASE_URL=

# E-mail (Resend) para verificação de conta e recuperação de senha — opcional
RESEND_API_KEY=
EMAIL_FROM=Sinuca Strike <onboarding@resend.dev>

# URL pública do backend (deixa os links de e-mail clicáveis)
PUBLIC_URL=

# Porta local (padrão 3000)
ADMIN_KEY=              # chave do painel /admin (conciliação)

PORT=3000
